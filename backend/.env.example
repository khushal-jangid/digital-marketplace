PORT=5000
NODE_ENV=development
MONGO_URI=your_mongodb_atlas_connection_string_here
JWT_SECRET=replace_with_a_long_random_secret
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Mail Setup (Gmail SMTP) - leave blank to log emails to console instead
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Store Name" <your_email@gmail.com>

# Telegram Instant Alerts (admin order notifications) - leave blank to disable
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
